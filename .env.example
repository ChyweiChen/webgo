# Copy this file to .env and adjust for your environment.
# .env is read automatically by `docker compose` and is git-ignored,
# so you can keep host-specific settings without touching tracked files.

# Host binding for the web container (format: [HOST_IP:]HOST_PORT).
# Default (no .env): 0.0.0.0:80
# Example for a server sitting behind nginx on the same host:
WEB_BIND=127.0.0.1:8000
